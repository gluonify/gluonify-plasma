<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.gluonify.plasma</groupId>
    <artifactId>gluonify-plasma</artifactId>
    <version>0.2.0-SNAPSHOT</version>
    <relativePath>..</relativePath>
  </parent>
  <artifactId>gluonify-plasma-crystallon-client</artifactId>
  <name>Gluonify Plasma Crystallon client</name>
  <description>HTTP client for gluonify-crystallon (PDF from a stored template): Java 17, no CDI, Jackson 2 or 3 detected at run time.</description>

  <properties>
    <!-- Quality ratchets (gluonify-plasma README, "Quality gates"): current coverage rounded down, raised with the tests, never lowered. -->
    <gluonify.coverage.minimum>0.94</gluonify.coverage.minimum>
    <gluonify.coverage.branch.minimum>0.80</gluonify.coverage.branch.minimum>
    <!-- Module published for customer applications: plain Java 17 (the parent compiles at 25). -->
    <maven.compiler.release>17</maven.compiler.release>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.gluonify.plasma</groupId>
      <artifactId>gluonify-plasma-sdk</artifactId>
    </dependency>
    <!-- Resolution without configuration (address and token): dependency-free jar, Java 17. -->
    <dependency>
      <groupId>io.gluonify.plasma</groupId>
      <artifactId>gluonify-plasma-services</artifactId>
    </dependency>

    <!-- Jackson 2 and Jackson 3: never transitive, the application brings the one it uses (run-time detection). -->
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${surefire.version}</version>
        <!--
          The same tests run with three classpaths (the actual exclusion is verified by the tests): Jackson 2 and 3 present
          (3 is preferred), Jackson 3 only, Jackson 2 only (with jsr310). Two more executions run only their own class: Jackson 2 without
          jsr310 (Jackson2NoJavaTime*) and no Jackson at all (NoJackson*: clear error).
        -->
        <executions>
          <execution>
            <id>default-test</id>
            <configuration>
              <excludes>
                <exclude>**/NoJackson*</exclude>
                <exclude>**/Jackson2NoJavaTime*</exclude>
              </excludes>
              <reportNameSuffix>both</reportNameSuffix>
              <systemPropertyVariables>
                <crystallon.test.jackson>both</crystallon.test.jackson>
              </systemPropertyVariables>
            </configuration>
          </execution>
          <execution>
            <id>jackson3-only</id>
            <phase>test</phase>
            <goals>
              <goal>test</goal>
            </goals>
            <configuration>
              <excludes>
                <exclude>**/NoJackson*</exclude>
                <exclude>**/Jackson2NoJavaTime*</exclude>
              </excludes>
              <reportNameSuffix>jackson3-only</reportNameSuffix>
              <classpathDependencyExcludes>
                <classpathDependencyExclude>com.fasterxml.jackson.core:jackson-databind</classpathDependencyExclude>
                <classpathDependencyExclude>com.fasterxml.jackson.core:jackson-core</classpathDependencyExclude>
                <classpathDependencyExclude>com.fasterxml.jackson.datatype:jackson-datatype-jsr310</classpathDependencyExclude>
              </classpathDependencyExcludes>
              <systemPropertyVariables>
                <crystallon.test.jackson>3</crystallon.test.jackson>
              </systemPropertyVariables>
            </configuration>
          </execution>
          <execution>
            <id>jackson2-only</id>
            <phase>test</phase>
            <goals>
              <goal>test</goal>
            </goals>
            <configuration>
              <excludes>
                <exclude>**/NoJackson*</exclude>
                <exclude>**/Jackson2NoJavaTime*</exclude>
              </excludes>
              <reportNameSuffix>jackson2-only</reportNameSuffix>
              <classpathDependencyExcludes>
                <classpathDependencyExclude>tools.jackson.core:jackson-databind</classpathDependencyExclude>
                <classpathDependencyExclude>tools.jackson.core:jackson-core</classpathDependencyExclude>
              </classpathDependencyExcludes>
              <systemPropertyVariables>
                <crystallon.test.jackson>2</crystallon.test.jackson>
              </systemPropertyVariables>
            </configuration>
          </execution>
          <execution>
            <id>jackson2-without-jsr310</id>
            <phase>test</phase>
            <goals>
              <goal>test</goal>
            </goals>
            <configuration>
              <includes>
                <include>**/Jackson2NoJavaTime*Test.java</include>
              </includes>
              <reportNameSuffix>jackson2-without-jsr310</reportNameSuffix>
              <classpathDependencyExcludes>
                <classpathDependencyExclude>tools.jackson.core:jackson-databind</classpathDependencyExclude>
                <classpathDependencyExclude>tools.jackson.core:jackson-core</classpathDependencyExclude>
                <classpathDependencyExclude>com.fasterxml.jackson.datatype:jackson-datatype-jsr310</classpathDependencyExclude>
              </classpathDependencyExcludes>
              <systemPropertyVariables>
                <crystallon.test.jackson>2-without-jsr310</crystallon.test.jackson>
              </systemPropertyVariables>
            </configuration>
          </execution>
          <execution>
            <id>no-jackson</id>
            <phase>test</phase>
            <goals>
              <goal>test</goal>
            </goals>
            <configuration>
              <includes>
                <include>**/NoJackson*Test.java</include>
              </includes>
              <reportNameSuffix>no-jackson</reportNameSuffix>
              <classpathDependencyExcludes>
                <classpathDependencyExclude>tools.jackson.core:jackson-databind</classpathDependencyExclude>
                <classpathDependencyExclude>tools.jackson.core:jackson-core</classpathDependencyExclude>
                <classpathDependencyExclude>com.fasterxml.jackson.core:jackson-databind</classpathDependencyExclude>
                <classpathDependencyExclude>com.fasterxml.jackson.core:jackson-core</classpathDependencyExclude>
                <classpathDependencyExclude>com.fasterxml.jackson.datatype:jackson-datatype-jsr310</classpathDependencyExclude>
              </classpathDependencyExcludes>
              <systemPropertyVariables>
                <crystallon.test.jackson>none</crystallon.test.jackson>
              </systemPropertyVariables>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
