<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>io.gluonify.plasma</groupId>
  <artifactId>gluonify-plasma</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Gluonify Plasma (parent)</name>
  <description>POM parent des composants Gluonify : plateforme Quarkus, versions, et le SDK partagé (gluonify-plasma-sdk).</description>

  <modules>
    <module>sdk</module>
    <module>services</module>
    <module>fermion-client</module>
    <module>crystallon-client</module>
    <module>testing</module>
    <module>quarkus</module>
    <module>cli</module>
  </modules>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <quarkus.platform.version>4.0.0.Beta1</quarkus.platform.version>
    <surefire.version>3.5.2</surefire.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.quarkus.platform</groupId>
        <artifactId>quarkus-bom</artifactId>
        <version>${quarkus.platform.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.gluonify.plasma</groupId>
        <artifactId>gluonify-plasma-sdk</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.gluonify.plasma</groupId>
        <artifactId>gluonify-plasma-fermion-client</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.gluonify.plasma</groupId>
        <artifactId>gluonify-plasma-crystallon-client</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.gluonify.plasma</groupId>
        <artifactId>gluonify-plasma-services</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.gluonify.plasma</groupId>
        <artifactId>gluonify-plasma-services</artifactId>
        <version>${project.version}</version>
        <type>test-jar</type>
      </dependency>
      <dependency>
        <groupId>io.gluonify.plasma</groupId>
        <artifactId>gluonify-plasma-testing</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.gluonify.plasma</groupId>
        <artifactId>gluonify-plasma-quarkus</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <!-- Versions de surefire et failsafe fixées pour tous les modules et tous les dépôts enfants : sans elles, la version vient de la distribution
       de Maven (le paquet Debian de Maven 3.9.9 lie surefire 2.17, qui ne voit pas les tests JUnit 5 et en exécute zéro, constaté sur quark le 2026-10-11). -->
  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${surefire.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>${surefire.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
