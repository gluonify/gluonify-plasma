<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>io.gluonify.plasma</groupId>
  <artifactId>gluonify-plasma</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Gluonify Plasma (parent)</name>
  <description>Parent POM of the Gluonify components: Quarkus platform, versions, and the shared SDK (gluonify-plasma-sdk).</description>

  <licenses>
    <license>
      <name>Apache-2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
    </license>
  </licenses>

  <modules>
    <module>sdk</module>
    <module>services</module>
    <module>fermion-client</module>
    <module>crystallon-client</module>
    <module>testing</module>
    <module>quarkus</module>
    <module>mcp</module>
    <module>cli</module>
  </modules>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <quarkus.platform.version>4.0.0.Beta1</quarkus.platform.version>
    <surefire.version>3.5.2</surefire.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.quarkus.platform</groupId>
        <artifactId>quarkus-bom</artifactId>
        <version>${quarkus.platform.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.gluonify.plasma</groupId>
        <artifactId>gluonify-plasma-sdk</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.gluonify.plasma</groupId>
        <artifactId>gluonify-plasma-sdk</artifactId>
        <version>${project.version}</version>
        <type>test-jar</type>
      </dependency>
      <dependency>
        <groupId>io.gluonify.plasma</groupId>
        <artifactId>gluonify-plasma-fermion-client</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.gluonify.plasma</groupId>
        <artifactId>gluonify-plasma-crystallon-client</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.gluonify.plasma</groupId>
        <artifactId>gluonify-plasma-services</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.gluonify.plasma</groupId>
        <artifactId>gluonify-plasma-services</artifactId>
        <version>${project.version}</version>
        <type>test-jar</type>
      </dependency>
      <dependency>
        <groupId>io.gluonify.plasma</groupId>
        <artifactId>gluonify-plasma-testing</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.gluonify.plasma</groupId>
        <artifactId>gluonify-plasma-quarkus</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.gluonify.plasma</groupId>
        <artifactId>gluonify-plasma-mcp</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <!-- Surefire and failsafe versions pinned for all modules and all child repositories: without them, the version comes from the Maven distribution
       (the Debian package of Maven 3.9.9 binds surefire 2.17, which does not see JUnit 5 tests and runs none, observed on quark on 2026-10-11). -->
  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${surefire.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>${surefire.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
