<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>io.gluonify.plasma</groupId>
  <artifactId>gluonify-plasma</artifactId>
  <version>0.2.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Gluonify Plasma (parent)</name>
  <description>Parent POM of the Gluonify components: Quarkus platform, versions, and the shared SDK (gluonify-plasma-sdk).</description>

  <licenses>
    <license>
      <name>Apache-2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
    </license>
  </licenses>

  <modules>
    <module>build-rules</module>
    <module>sdk</module>
    <module>services</module>
    <module>fermion-client</module>
    <module>crystallon-client</module>
    <module>testing</module>
    <module>quarkus</module>
    <module>mcp</module>
    <module>cli</module>
  </modules>

  <properties>
    <!-- Default of -DskipTests, read by the coverage check (skipped when the tests are). -->
    <skipTests>false</skipTests>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <quarkus.platform.version>4.0.0.Beta1</quarkus.platform.version>
    <!-- Jackson 3 above the Quarkus BOM (security fixes; dependencyManagement) -->
    <jackson.version>3.1.8</jackson.version>
    <surefire.version>3.5.2</surefire.version>
    <!-- Quality gates of every build (README, "Quality gates"): versions, and the ratchets each repository sets to its current level. -->
    <jacoco.version>0.8.14</jacoco.version>
    <pmd.plugin.version>3.28.0</pmd.plugin.version>
    <pmd.version>7.28.0</pmd.version>
    <!-- Version of the plasma artifacts this parent manages, kept equal to this POM's version (bin/publish-sdk.sh of gluonify-chamber sets both).
         A literal and not ${project.version}: Maven interpolates an inherited dependencyManagement in the CHILD's context, so a customer
         project with the parent 0.7.3 asked for gluonify-plasma-sdk at its own version (gluonify-probe, quark, 2026-10-23). -->
    <gluonify.plasma.version>0.2.0-SNAPSHOT</gluonify.plasma.version>
    <!-- Version of gluonify-plasma-build-rules (the PMD ruleset). -->
    <gluonify.build-rules.version>${gluonify.plasma.version}</gluonify.build-rules.version>
    <!-- Coverage ratchet (JaCoCo, whole module): each repository sets its current level rounded down, raises it with its tests, never lowers it. -->
    <gluonify.coverage.minimum>0.95</gluonify.coverage.minimum>
    <gluonify.coverage.branch.minimum>${gluonify.coverage.minimum}</gluonify.coverage.branch.minimum>
    <!-- Existing PMD debt only (class=Rule,Rule): a line is removed when its class is fixed, never added. -->
    <gluonify.pmd.baseline>${project.basedir}/pmd-baseline.properties</gluonify.pmd.baseline>
  </properties>

  <!-- gluonify-sea's Maven repository, where this parent, the SDK and gluonify-plasma-build-rules are published: a customer project on this parent
       resolves the PMD ruleset of the quality profile (a PLUGIN dependency, read only from <pluginRepositories>) from it, as it resolved the parent.
       Releases only: the internal snapshot builds never query it. -->
  <repositories>
    <repository>
      <id>gluonify-sea</id>
      <url>https://images.gluonify.io/maven</url>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
    </repository>
  </repositories>
  <pluginRepositories>
    <pluginRepository>
      <id>gluonify-sea</id>
      <url>https://images.gluonify.io/maven</url>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
    </pluginRepository>
  </pluginRepositories>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <!-- Before the Quarkus BOM, so that it wins: Quarkus 4.0.0.Beta1 brings Jackson 3.1.4, with high advisories fixed in 3.1.6 and 3.1.7
             (GHSA-7hhh-6rmp-j9qf, -p6pp-m3f8-5c89, -cxp5-3px4-pw24, -q4xh-88c3-wmh7, -wv8q-qhhj-9h54; gluonify-chamber/bin/sbom.py audit, 2026-10-24).
             Every component and customer project inheriting this parent gets it. Remove once the Quarkus BOM is at 3.1.7 or later. -->
        <groupId>tools.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>${jackson.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.quarkus.platform</groupId>
        <artifactId>quarkus-bom</artifactId>
        <version>${quarkus.platform.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.gluonify.plasma</groupId>
        <artifactId>gluonify-plasma-sdk</artifactId>
        <version>${gluonify.plasma.version}</version>
      </dependency>
      <dependency>
        <groupId>io.gluonify.plasma</groupId>
        <artifactId>gluonify-plasma-sdk</artifactId>
        <version>${gluonify.plasma.version}</version>
        <type>test-jar</type>
      </dependency>
      <dependency>
        <groupId>io.gluonify.plasma</groupId>
        <artifactId>gluonify-plasma-fermion-client</artifactId>
        <version>${gluonify.plasma.version}</version>
      </dependency>
      <dependency>
        <groupId>io.gluonify.plasma</groupId>
        <artifactId>gluonify-plasma-crystallon-client</artifactId>
        <version>${gluonify.plasma.version}</version>
      </dependency>
      <dependency>
        <groupId>io.gluonify.plasma</groupId>
        <artifactId>gluonify-plasma-services</artifactId>
        <version>${gluonify.plasma.version}</version>
      </dependency>
      <dependency>
        <groupId>io.gluonify.plasma</groupId>
        <artifactId>gluonify-plasma-services</artifactId>
        <version>${gluonify.plasma.version}</version>
        <type>test-jar</type>
      </dependency>
      <dependency>
        <groupId>io.gluonify.plasma</groupId>
        <artifactId>gluonify-plasma-testing</artifactId>
        <version>${gluonify.plasma.version}</version>
      </dependency>
      <dependency>
        <groupId>io.gluonify.plasma</groupId>
        <artifactId>gluonify-plasma-quarkus</artifactId>
        <version>${gluonify.plasma.version}</version>
      </dependency>
      <dependency>
        <groupId>io.gluonify.plasma</groupId>
        <artifactId>gluonify-plasma-mcp</artifactId>
        <version>${gluonify.plasma.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <!-- Surefire and failsafe versions pinned for all modules and all child repositories: without them, the version comes from the Maven distribution
       (the Debian package of Maven 3.9.9 binds surefire 2.17, which does not see JUnit 5 tests and runs none, observed on quark on 2026-10-11). -->
  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${surefire.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>${surefire.version}</version>
        </plugin>
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>${jacoco.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-pmd-plugin</artifactId>
          <version>${pmd.plugin.version}</version>
          <configuration>
            <rulesets>
              <ruleset>gluonify/pmd/ruleset.xml</ruleset>
            </rulesets>
            <targetJdk>${maven.compiler.release}</targetJdk>
            <includeTests>false</includeTests>
            <failurePriority>5</failurePriority>
            <printFailingErrors>true</printFailingErrors>
            <excludeFromFailureFile>${gluonify.pmd.baseline}</excludeFromFailureFile>
            <linkXRef>false</linkXRef>
            <analysisCache>true</analysisCache>
          </configuration>
          <dependencies>
            <dependency>
              <groupId>net.sourceforge.pmd</groupId>
              <artifactId>pmd-core</artifactId>
              <version>${pmd.version}</version>
            </dependency>
            <dependency>
              <groupId>net.sourceforge.pmd</groupId>
              <artifactId>pmd-java</artifactId>
              <version>${pmd.version}</version>
            </dependency>
            <dependency>
              <groupId>net.sourceforge.pmd</groupId>
              <artifactId>pmd-javascript</artifactId>
              <version>${pmd.version}</version>
            </dependency>
            <dependency>
              <groupId>net.sourceforge.pmd</groupId>
              <artifactId>pmd-jsp</artifactId>
              <version>${pmd.version}</version>
            </dependency>
            <dependency>
              <groupId>io.gluonify.plasma</groupId>
              <artifactId>gluonify-plasma-build-rules</artifactId>
              <version>${gluonify.build-rules.version}</version>
            </dependency>
          </dependencies>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <profiles>
    <!-- Quality gates (README, "Quality gates"): active in every module that has Java sources, so that the parent POMs and the build-rules module
         (no code) neither need the ruleset nor measure anything; PMD is in the next profile. `mvn verify` fails like a red test when the coverage falls below the ratchet or
         when PMD finds a violation that is not in the module's pmd-baseline.properties. -Djacoco.skip / -Dpmd.skip for a scoped run. -->
    <profile>
      <id>gluonify-quality</id>
      <activation>
        <file>
          <exists>${basedir}/src/main/java</exists>
        </file>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.jacoco</groupId>
            <artifactId>jacoco-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>gluonify-coverage-agent</id>
                <goals>
                  <goal>prepare-agent</goal>
                </goals>
              </execution>
              <execution>
                <id>gluonify-coverage-report</id>
                <phase>verify</phase>
                <goals>
                  <goal>report</goal>
                </goals>
                <configuration>
                  <!-- As the check below: no report from a stale target/jacoco.exec when the tests are skipped. -->
                  <skip>${skipTests}</skip>
                </configuration>
              </execution>
              <execution>
                <id>gluonify-coverage-check</id>
                <phase>verify</phase>
                <goals>
                  <goal>check</goal>
                </goals>
                <configuration>
                  <!-- No tests run, no coverage to check: with -DskipTests (a native build's "mvn -DskipTests install") the check would read
                       a stale target/jacoco.exec left in the build context and fail on code it never measured (quark, 2026-10-20). -->
                  <skip>${skipTests}</skip>
                  <rules>
                    <rule>
                      <element>BUNDLE</element>
                      <limits>
                        <limit>
                          <counter>LINE</counter>
                          <value>COVEREDRATIO</value>
                          <minimum>${gluonify.coverage.minimum}</minimum>
                        </limit>
                        <limit>
                          <counter>BRANCH</counter>
                          <value>COVEREDRATIO</value>
                          <minimum>${gluonify.coverage.branch.minimum}</minimum>
                        </limit>
                      </limits>
                    </rule>
                  </rules>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!-- PMD with the ruleset of gluonify-plasma-build-rules (README, "Quality gates"): on by default in every module with Java sources, customer
         projects included (decision of the user, 2026-10-23). -Dgluonify.plasma.pmd.skip=true (command line or the project's .mvn/maven.config)
         turns it off: the profile is then inactive and neither the plugin nor the ruleset is resolved (an inactive profile fetches nothing from sea). -->
    <profile>
      <id>gluonify-pmd</id>
      <activation>
        <file>
          <exists>${basedir}/src/main/java</exists>
        </file>
        <property>
          <name>gluonify.plasma.pmd.skip</name>
          <value>!true</value>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-pmd-plugin</artifactId>
            <executions>
              <execution>
                <id>gluonify-pmd-check</id>
                <goals>
                  <goal>check</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!-- Coverage of @QuarkusTest (README, "Quality gates"): Quarkus transforms the bean classes, so the JaCoCo agent data no longer matches
         target/classes and a class reached only through a @QuarkusTest reads 0 %. quarkus-jacoco instruments them at test build time and appends
         to the agent's file, which the report and the check above read. Active in every Quarkus application (src/main/resources/application.properties);
         -Dgluonify.quarkus-coverage.skip turns it off. -->
    <profile>
      <id>gluonify-quarkus-coverage</id>
      <activation>
        <file>
          <exists>${basedir}/src/main/resources/application.properties</exists>
        </file>
        <property>
          <name>!gluonify.quarkus-coverage.skip</name>
        </property>
      </activation>
      <dependencies>
        <dependency>
          <groupId>io.quarkus</groupId>
          <artifactId>quarkus-jacoco</artifactId>
          <scope>test</scope>
        </dependency>
      </dependencies>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <systemPropertyVariables>
                <!-- Absolute path: a relative one resolves against the module root, not target/. -->
                <quarkus.jacoco.data-file>${project.build.directory}/jacoco.exec</quarkus.jacoco.data-file>
                <quarkus.jacoco.reuse-data-file>true</quarkus.jacoco.reuse-data-file>
                <!-- The build's JaCoCo report is the only one. -->
                <quarkus.jacoco.report>false</quarkus.jacoco.report>
              </systemPropertyVariables>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
